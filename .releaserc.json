{
  "branches": ["main"],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "files": ["packages/biblioflow/src/biblioflow/__init__.py"],
            "from": "__version__ = \".*\"  # semantic-release",
            "to": "__version__ = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow/src/biblioflow/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": ["packages/biblioflow/pyproject.toml"],
            "from": "version = \".*\"  # semantic-release",
            "to": "version = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow/pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": ["CITATION.cff"],
            "from": "version: \".*\" # semantic-release",
            "to": "version: \"${nextRelease.version}\" # semantic-release",
            "results": [
              {
                "file": "CITATION.cff",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Release Notes\n---",
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cd packages/biblioflow && poetry build",
        "publishCmd": "cd packages/biblioflow && poetry publish"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": ["packages/biblioflow/dist/*.whl", "packages/biblioflow/dist/*.tar.gz"]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "packages/biblioflow/pyproject.toml",
          "CHANGELOG.md",
          "packages/biblioflow/src/biblioflow/__init__.py",
          "CITATION.cff"
        ],
        "message": "chore(release): ${nextRelease.version}"
      }
    ]
  ]
}
