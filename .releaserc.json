{
  "branches": [
    "main"
  ],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    [
      "@google/semantic-release-replace-plugin",
      {
        "replacements": [
          {
            "files": [
              "packages/biblioflow/src/biblioflow/__init__.py"
            ],
            "from": "__version__ = \".*\"  # semantic-release",
            "to": "__version__ = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow/src/biblioflow/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow/pyproject.toml"
            ],
            "from": "version = \".*\"  # semantic-release",
            "to": "version = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow/pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow-web/backend/src/biblioflow_web_backend/__init__.py"
            ],
            "from": "__version__ = \".*\"  # semantic-release",
            "to": "__version__ = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow-web/backend/src/biblioflow_web_backend/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow-web/backend/pyproject.toml"
            ],
            "from": "version = \".*\"  # semantic-release",
            "to": "version = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow-web/backend/pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow-web/backend/pyproject.toml"
            ],
            "from": "\"biblioflow>=.*\",",
            "to": "\"biblioflow>=${nextRelease.version}\",",
            "results": [
              {
                "file": "packages/biblioflow-web/backend/pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow-nb/src/biblioflow_nb/__init__.py"
            ],
            "from": "__version__ = \".*\"  # semantic-release",
            "to": "__version__ = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow-nb/src/biblioflow_nb/__init__.py",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow-nb/pyproject.toml"
            ],
            "from": "version = \".*\"  # semantic-release",
            "to": "version = \"${nextRelease.version}\"  # semantic-release",
            "results": [
              {
                "file": "packages/biblioflow-nb/pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "packages/biblioflow-nb/pyproject.toml"
            ],
            "from": "\"biblioflow>=.*\",",
            "to": "\"biblioflow>=${nextRelease.version}\",",
            "results": [
              {
                "file": "packages/biblioflow-nb/pyproject.toml",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          },
          {
            "files": [
              "CITATION.cff"
            ],
            "from": "version: \".*\" # semantic-release",
            "to": "version: \"${nextRelease.version}\" # semantic-release",
            "results": [
              {
                "file": "CITATION.cff",
                "hasChanged": true,
                "numMatches": 1,
                "numReplacements": 1
              }
            ],
            "countMatches": true
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/changelog",
      {
        "changelogTitle": "# Release Notes\n---",
        "changelogFile": "CHANGELOG.md"
      }
    ],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "cd packages/biblioflow && poetry build && cd ../biblioflow-web/backend && python scripts/build_frontend.py && poetry build && cd ../../biblioflow-nb && poetry build",
        "publishCmd": "cd packages/biblioflow && poetry publish && cd ../biblioflow-web/backend && poetry publish && cd ../../biblioflow-nb && poetry publish"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "packages/biblioflow/dist/*.whl",
          "packages/biblioflow/dist/*.tar.gz",
          "packages/biblioflow-web/backend/dist/*.whl",
          "packages/biblioflow-web/backend/dist/*.tar.gz",
          "packages/biblioflow-nb/dist/*.whl",
          "packages/biblioflow-nb/dist/*.tar.gz"
        ]
      }
    ],
    [
      "@semantic-release/git",
      {
        "assets": [
          "packages/biblioflow/pyproject.toml",
          "packages/biblioflow-web/backend/pyproject.toml",
          "CHANGELOG.md",
          "packages/biblioflow/src/biblioflow/__init__.py",
          "packages/biblioflow-web/backend/src/biblioflow_web_backend/__init__.py",
          "CITATION.cff",
          "packages/biblioflow-nb/pyproject.toml",
          "packages/biblioflow-nb/src/biblioflow_nb/__init__.py"
        ],
        "message": "chore(release): ${nextRelease.version}"
      }
    ]
  ]
}
